      <tag k="description" v="Le territoire français couvert par l’Union européenne."/>
      <tag k="name" v="France UE"/>
      <tag k="name:de" v="Frankreich EU"/>
      <tag k="name:en" v="France EU"/>
      <tag k="name:es" v="Francia UE"/>
      <tag k="name:fr" v="France UE"/>
