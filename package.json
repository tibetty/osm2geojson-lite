{
  "name": "osm2geojson-lite",
  "version": "2.7.7",
  "description": "full-featured OpenStreetMap to GeoJSON convertor - OSM XML, osmChange, PBF and Overpass JSON, history and diff application, zero dependencies, 10-18x faster than osmtogeojson on XML",
  "author": "tibetty",
  "license": "MIT",
  "main": "dist/index.cjs",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/**/*.cjs",
    "dist/**/*.mjs",
    "dist/**/*.d.ts",
    "dist/**/*.json"
  ],
  "scripts": {
    "build": "rolldown -c && cp src/polytags.json dist/",
    "test": "npm run test:unit && npm run audit:versions",
    "test:unit": "vitest run --coverage",
    "test:update": "UPDATE_SNAPSHOTS=1 vitest run test/e2e.test.ts",
    "audit:versions": "npm run build && node scripts/audit-versions.mjs",
    "bench": "vitest bench --run --reporter=verbose",
    "prebench": "npm run build",
    "valid": "node scripts/serve.mjs",
    "prevalid": "npm run build"
  },
  "optionalDependencies": {
    "@types/geojson": "^7946.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@vitest/coverage-v8": "^5.1.0",
    "@xmldom/xmldom": "^0.9.10",
    "osm2geojson-ultra": "^4.1.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "rolldown": "^1.1.1",
    "rolldown-plugin-dts": "^0.25.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "bin": {
    "osm2geojson-lite": "dist/cli.mjs"
  },
  "overrides": {
    "osmtogeojson": {
      "@xmldom/xmldom": "^0.9.12"
    }
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tibetty/osm2geojson-lite.git"
  },
  "bugs": {
    "url": "https://github.com/tibetty/osm2geojson-lite/issues"
  },
  "homepage": "https://github.com/tibetty/osm2geojson-lite#readme",
  "keywords": [
    "openstreetmap",
    "overpass",
    "osm",
    "json",
    "xml",
    "node",
    "way",
    "relation",
    "geojson",
    "linestring",
    "multilinestring",
    "polygon",
    "multipolygon"
  ]
}
